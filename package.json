{
  "name": "bein-erp-docs",
  "private": true,
  "version": "0.1.0",
  "description": "Public technical documentation for BEIN ERP",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve build",
    "check": "npm run check:navigation && npm run check:api-facts && npm run check:resource-docs && npm run build",
    "check:navigation": "node scripts/check-docs-navigation.mjs",
    "check:api-facts": "node scripts/check-api-facts.mjs",
    "check:resource-docs": "node scripts/check-resource-docs.mjs",
    "generate:reference": "node scripts/generate-reference.mjs --backend=../erp-backend",
    "format:payloads": "node scripts/format-json-fences.mjs",
    "generate:all-docs": "npm run generate:reference && npm run format:payloads"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
