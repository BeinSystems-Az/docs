{
  "name": "bein-erp-docs",
  "private": true,
  "version": "0.1.0",
  "description": "Public technical documentation for BEIN ERP",
  "scripts": {
    "start": "docusaurus start",
    "build:api": "redocly build-docs openapi/openapi.yaml -o static/api/index.html",
    "build": "npm run build:api && docusaurus build",
    "serve": "docusaurus serve build",
    "lint:openapi": "redocly lint openapi/openapi.yaml",
    "check": "npm run lint:openapi && npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
